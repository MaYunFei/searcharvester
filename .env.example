# ── User/Group IDs for the hermes user ────────────────────────────────
# Match your host user's UID/GID so mounted volumes have correct ownership.
# Linux: typically 1000:1000. macOS: typically 501:20.
HERMES_UID=1000
HERMES_GID=1000

# ── LLM credentials (for /research) ────────────────────────────────────
# DeepSeek example:
#   OPENAI_API_KEY=sk-your-deepseek-key
#   OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ── API Key for protecting the service ─────────────────────────────────
# Leave empty to disable authentication (not recommended for public access).
# Run: python3 -c "import secrets; print(secrets.token_hex(24))"
API_KEY=

# ── Tavily API Key (for proxy fallback) ────────────────────────────────
# Only needed if you run the proxy with Tavily fallback enabled.
TAVILY_API_KEY=

# ── Frontend build-time variables ──────────────────────────────────────
# VITE_API_URL should point to the proxy (or directly to tavily-adapter).
# Use the LAN IP so other machines on the network can reach it.
VITE_API_URL=http://localhost:8001
VITE_API_KEY=
